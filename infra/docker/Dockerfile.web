FROM node:20-alpine

WORKDIR /app

RUN npm install -g pnpm

# Copy root monorepo files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy packages and apps 
COPY packages/ ./packages/
COPY apps/ ./apps/

RUN pnpm install

WORKDIR /app/apps/web

EXPOSE 5173

CMD ["pnpm", "run", "dev", "--host"]
